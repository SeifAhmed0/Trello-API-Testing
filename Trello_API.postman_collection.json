	"item": [
		{
			"name": "Create board",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"check status code\", () => {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"const response = pm.response.json();\r",
							"pm.collectionVariables.set(\"boardId\", pm.response.json().id);\r",
							"pm.test(\"Board is created\", () => {\r",
							"    pm.expect(response.name).to.eql(\"Learning Postman\" + pm.collectionVariables.get(\"boardNumber\"));\r",
							"    pm.expect(response.closed).to.be.false;\r",
							"});\r",
							"pm.test(\"Board is private\", () => {\r",
							"    const permistionLevel = response.prefs.permissionLevel;\r",
							"    pm.expect(permistionLevel).to.eql(\"private\");\r",
							"});\r",
							"\r",
							"pm.test(\"Calendar is disabled\", () => {\r",
							"    const calenderType = response.prefs.switcherViews;\r",
							"    const ans = calenderType.find(c => c.viewType === 'Calendar');\r",
							"    console.log(ans);\r",
							"    pm.expect(ans.enabled).to.be.false;\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let boardNumber = pm.collectionVariables.get(\"boardNumber\");\r",
							"if(isNaN(boardNumber)){\r",
							"    boardNumber = 0;\r",
							"}\r",
							"boardNumber++;\r",
							"pm.collectionVariables.set(\"boardNumber\", boardNumber);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/1/boards/?name=Learning Postman{{boardNumber}}&key={{trelloKey}}&token={{trelloToken}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
